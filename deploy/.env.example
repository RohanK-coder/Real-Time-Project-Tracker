# Copy to deploy/.env and replace every value. Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxxxxxxxxxxxxx
# Public URL the browser uses (for WebSocket origin checks)
PUBLIC_ORIGIN=http://localhost:8088
HTTP_PORT=8088
BACKEND_REPLICAS=2
# Optional
GITHUB_WEBHOOK_SECRET=
# Demo accounts (admin/alice/bob/carol). Leave false for a real deployment.
# If you set SEED_DEMO=true, SEED_DEMO_PASSWORD must be set too (it is the password for all four).
SEED_DEMO=false
SEED_DEMO_PASSWORD=demo1234
LOGIN_RATE_LIMIT=10
